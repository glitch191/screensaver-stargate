<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console check of the fixed time step simulation; reuses the app sources, no packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/Simulation.cs" Link="Simulation.cs" />
    <Compile Include="../../src/Settings.cs" Link="Settings.cs" />
    <Compile Include="../../src/Log.cs" Link="Log.cs" />
  </ItemGroup>

</Project>
